      "name": "홈 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/home?userId={{userId}}&categoryId=2&keyword=치킨"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('상태 코드 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON 응답', () => pm.response.to.be.json);"
            ]
          }
        }
      ]
    },
